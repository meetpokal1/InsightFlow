# Copy this file to .env and change the values. .env is git-ignored, so never commit it.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_intelligence
DB_USER=sales_user
DB_PASSWORD=change_me

# A full SQLAlchemy URL overrides the DB_* values above
# DATABASE_URL=postgresql+psycopg2://sales_user:change_me@localhost:5432/sales_intelligence

# Data folders (relative paths start from the project root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Orders dated after this day are treated as invalid.
# Leave it empty to use today's date, or set it to get repeatable runs.
AS_OF_DATE=

LOG_LEVEL=INFO
