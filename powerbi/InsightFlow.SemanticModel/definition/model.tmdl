model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sales","Inventory","Product","Customer","Location","Date","DataQualityReconciliation","DataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Inventory
ref table Product
ref table Customer
ref table Location
ref table Date
ref table DataQualityReconciliation

