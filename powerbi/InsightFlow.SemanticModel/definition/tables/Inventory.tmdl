/// Stock snapshot and buffer replenishment metrics as of 30 Sept 2026
table Inventory
	lineageTag: 05672b54-f8be-41b6-a172-2583c3f86a37

	/// Total valuation of stock on hand at cost price (₹22.49M)
	measure 'Stock Value' = SUM(Inventory[inventory_value])
		formatString: "₹"#,##0
		lineageTag: 28129eed-62af-4ac4-973d-730938fa6576

	/// Presentation-only currency label; the canonical Stock Value measure remains numeric.
	measure 'Stock Value Display' = "₹" & FORMAT(DIVIDE([Stock Value], 10000000), "0.00") & " Cr"
		lineageTag: 7cdb76c4-3f66-4d1b-8d1c-1f71d8b1a001

	/// Total tracked product-location inventory positions (449)
	measure 'Stock Positions' = COUNTROWS(Inventory)
		formatString: #,0
		lineageTag: 6710f42a-e38c-4734-b64d-80f6bd411a53

	/// Average days of stock cover based on 90-day run rate
	measure 'Days of Cover' = AVERAGE(Inventory[days_of_cover])
		formatString: 0.0
		lineageTag: 6c1d75ae-c94b-4a3c-92d7-dd1fb03eb397

	/// Positions requiring purchasing review (92)
	measure 'Items Needing Action' = CALCULATE(COUNTROWS(Inventory), Inventory[stock_status] IN {"Out of stock", "Stock-out risk", "Low stock"})
		formatString: #,0
		lineageTag: 9fa4cd34-eeb7-4618-817a-0afdccbbd9e9

	/// True out of stock positions with 0 units on hand (40 positions)
	measure 'Stockout Positions' = CALCULATE(COUNTROWS(Inventory), Inventory[quantity_on_hand] = 0)
		formatString: #,0
		lineageTag: 32c0c92a-bf34-406d-936a-b1ba7c771e1e

	/// Positions where stock is below reorder threshold (96 positions)
	measure 'Positions Below Reorder' = CALCULATE(COUNTROWS(Inventory), Inventory[quantity_on_hand] < Inventory[reorder_level])
		formatString: #,0
		lineageTag: 5c12e10c-0147-402f-8389-ad4719abe11b

	/// Total units required to restore depleted buffers to reorder level (5,791 units)
	measure 'Replenishment Qty Required' = SUM(Inventory[replenishment_quantity_required])
		formatString: #,0
		lineageTag: c686f0b5-5ff2-4901-b7f5-316b4ddb928c

	/// Working capital required at purchase cost to restore buffer stock (₹9.66 L)
	measure 'Replenishment Cost Estimate' = SUM(Inventory[replenishment_cost_estimate])
		formatString: "₹"#,##0
		lineageTag: 55d4ba0a-8533-44e5-93fb-90fe72792fec

	/// Presentation-only currency label; the canonical cost estimate remains numeric.
	measure 'Replenishment Cost Estimate Display' = "₹" & FORMAT(DIVIDE([Replenishment Cost Estimate], 100000), "0.00") & " L"
		lineageTag: 7cdb76c4-3f66-4d1b-8d1c-1f71d8b1a002

	/// Catalog retail valuation of buffer deficit units; NOT lost revenue (₹13.41 L)
	measure 'Stock Gap Retail Valuation' = SUM(Inventory[stock_gap_retail_valuation])
		formatString: "₹"#,##0
		lineageTag: 7b12bb69-80d2-4aa9-af3d-df27e29fc91e

	/// Presentation-only currency label; the canonical retail valuation remains numeric.
	measure 'Stock Gap Retail Valuation Display' = "₹" & FORMAT(DIVIDE([Stock Gap Retail Valuation], 100000), "0.00") & " L"
		lineageTag: 7cdb76c4-3f66-4d1b-8d1c-1f71d8b1a003

	column inventory_id
		dataType: string
