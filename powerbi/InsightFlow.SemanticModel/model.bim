      {
        "name": "DataQualityReconciliation",
        "description": "Pipeline data assurance reconciliation matrix",
        "columns": [
          {
            "name": "table_name",
            "dataType": "string",
            "sourceColumn": "table_name"
          },
          {
            "name": "raw_ingested",
            "dataType": "int64",
            "sourceColumn": "raw_ingested",
            "formatString": "#,0"
          },
          {
            "name": "exact_duplicates_dropped",
            "dataType": "int64",
            "sourceColumn": "exact_duplicates_dropped",
            "formatString": "#,0"
          },
          {
            "name": "quarantined_rejected",
            "dataType": "int64",
            "sourceColumn": "quarantined_rejected",
            "formatString": "#,0"
          },
          {
            "name": "merged_deduplicated",
            "dataType": "int64",
            "sourceColumn": "merged_deduplicated",
            "formatString": "#,0"
          },
          {
            "name": "clean_loaded",
            "dataType": "int64",
            "sourceColumn": "clean_loaded",
            "formatString": "#,0"
          },
          {
            "name": "reconciliation_status",
            "dataType": "string",
            "sourceColumn": "reconciliation_status"
          },
          {
            "name": "preservation_rate",
            "dataType": "double",
            "sourceColumn": "preservation_rate",
            "formatString": "0.0%"
          }
        ],
        "measures": [
          {
            "name": "Total Raw Records",
            "expression": "SUM(DataQualityReconciliation[raw_ingested])",
            "formatString": "#,0"
          },
          {
            "name": "Total Clean Records",
            "expression": "SUM(DataQualityReconciliation[clean_loaded])",
            "formatString": "#,0"
          },
          {
            "name": "Overall Preservation Rate %",
            "expression": "DIVIDE([Total Clean Records], [Total Raw Records])",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "ReconciliationPartition",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FolderPath = if Text.EndsWith(DataFolder, \"\\\") or Text.EndsWith(DataFolder, \"/\") then DataFolder else DataFolder & \"\\\",",
                "    Source = Csv.Document(File.Contents(FolderPath & \"data_assurance_reconciliation.csv\"), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\", {{\"table_name\", type text}, {\"raw_ingested\", Int64.Type}, {\"exact_duplicates_dropped\", Int64.Type}, {\"quarantined_rejected\", Int64.Type}, {\"merged_deduplicated\", Int64.Type}, {\"clean_loaded\", Int64.Type}, {\"reconciliation_status\", type text}, {\"preservation_rate\", type number}}, \"en-US\")",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Sales_Product",
        "fromTable": "Sales",
        "fromColumn": "product_id",
        "toTable": "Product",
        "toColumn": "product_id"
      },
      {
        "name": "Sales_Customer",
        "fromTable": "Sales",
        "fromColumn": "customer_id",
        "toTable": "Customer",
        "toColumn": "customer_id"
      },
      {
        "name": "Sales_Location",
        "fromTable": "Sales",
        "fromColumn": "location_id",
        "toTable": "Location",
        "toColumn": "location_id"
      },
      {
        "name": "Sales_Date",
        "fromTable": "Sales",
        "fromColumn": "order_date",
        "toTable": "Date",
        "toColumn": "date_key"
      },
      {
        "name": "Inventory_Product",
        "fromTable": "Inventory",
        "fromColumn": "product_id",
        "toTable": "Product",
        "toColumn": "product_id"
      },
      {
        "name": "Inventory_Location",
        "fromTable": "Inventory",
        "fromColumn": "location_id",
        "toTable": "Location",
        "toColumn": "location_id"
      }
    ]
  }
}