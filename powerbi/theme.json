{
  "name": "Sales and Inventory",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "minimum": "#CDE2FB",
  "maximum": "#184F95",
  "null": "#898781",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#52514E" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FCFCFB" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 4 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B0B0B" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F9F9F7" } }, "transparency": 0 }]
      }
    }
  }
}
